class Solution {
public:
    int scoreOfParentheses(string s) {
        stack<int> st;
        st.push(0);

        for (char ch : s) {
            if (ch == '(') {
                st.push(0);
            } 
            else {
                int current = st.top();
                st.pop();

                int score;

                if (current == 0)
                    score = 1;              // "()"
                else
                    score = 2 * current;   // "(A)"

                st.top() += score;          // AB
            }
        }

        return st.top();
    }
};
