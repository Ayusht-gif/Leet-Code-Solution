class Solution {
public:
    set<string> solve(string &s, int &i) {
        set<string> result;
        set<string> current = {""};

        while (i < s.size() && s[i] != '}') {

            if (s[i] == '{') {
                i++;  // skip '{'

                set<string> inside = solve(s, i);

                i++;  // skip '}'

                set<string> temp;

                // Concatenate current with inside
                for (string a : current) {
                    for (string b : inside) {
                        temp.insert(a + b);
                    }
                }

                current = temp;
            }

            else if (s[i] == ',') {
                i++;  // skip ','

                // Union current into result
                result.insert(current.begin(), current.end());

                current = {""};
            }

            else {
                // lowercase letter
                string ch(1, s[i]);
                i++;

                set<string> temp;

                for (string a : current) {
                    temp.insert(a + ch);
                }

                current = temp;
            }
        }

        // Add the last part
        result.insert(current.begin(), current.end());

        return result;
    }

    vector<string> braceExpansionII(string expression) {
        int i = 0;

        set<string> ans = solve(expression, i);

        return vector<string>(ans.begin(), ans.end());
    }
};
