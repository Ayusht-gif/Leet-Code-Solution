class Solution {
public:
    vector<int> validSequence(string word1, string word2) {

        int n = word1.size();
        int m = word2.size();

        vector<int> right(n + 1, 0);

        int j = m - 1;

        for (int i = n - 1; i >= 0; i--) {

            if (j >= 0 && word1[i] == word2[j]) {
                j--;
            }

            right[i] = m - 1 - j;
        }

        vector<int> ans;

        j = 0;
        bool used = false;

        for (int i = 0; i < n && j < m; i++) {

            if (word1[i] == word2[j]) {
                ans.push_back(i);
                j++;
            }

            else if (used == false) {

                int remaining = m - j - 1;

                if (right[i + 1] >= remaining) {

                    ans.push_back(i);
                    j++;
                    used = true;
                }
            }
        }

        if (ans.size() != m) {
            return {};
        }

        return ans;
    }
};
