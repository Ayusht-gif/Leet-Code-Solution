class Solution {
public:
    long long findKthSmallest(vector<int>& coins, int k) {
        int n = coins.size();

        auto count = [&](long long x) -> long long {
            long long total = 0;

            for (int mask = 1; mask < (1 << n); mask++) {
                long long lcm = 1;
                int bits = 0;
                bool possible = true;

                for (int i = 0; i < n; i++) {
                    if (mask & (1 << i)) {
                        bits++;

                        long long g = gcd(lcm, (long long)coins[i]);

                        // Prevent overflow
                        if (lcm > x / (coins[i] / g)) {
                            possible = false;
                            break;
                        }

                        lcm = lcm / g * coins[i];

                        if (lcm > x) {
                            possible = false;
                            break;
                        }
                    }
                }

                if (!possible) continue;

                long long multiples = x / lcm;

                if (bits % 2 == 1)
                    total += multiples;
                else
                    total -= multiples;
            }

            return total;
        };

        long long low = 1;
        long long high = 1e11;

        while (low < high) {
            long long mid = low + (high - low) / 2;

            if (count(mid) >= k)
                high = mid;
            else
                low = mid + 1;
        }

        return low;
    }
};
