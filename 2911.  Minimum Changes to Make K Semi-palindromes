class Solution {
public:
    int minimumChanges(string s, int k) {
        int n = s.size();
        const int INF = 1e9;

        vector<vector<int>> cost(n, vector<int>(n, INF));

        // Precompute minimum changes for every substring
        for (int l = 0; l < n; l++) {
            for (int r = l + 1; r < n; r++) {

                int len = r - l + 1;

                // Try every proper divisor
                for (int d = 1; d < len; d++) {

                    if (len % d != 0)
                        continue;

                    int changes = 0;

                    // Check palindrome groups
                    for (int offset = 0; offset < d; offset++) {

                        int left = l + offset;
                        int right = r - ((len - 1 - offset) % d);

                        while (left < right) {
                            if (s[left] != s[right])
                                changes++;

                            left += d;
                            right -= d;
                        }
                    }

                    cost[l][r] = min(cost[l][r], changes);
                }
            }
        }

        // DP: dp[i][j] = minimum changes to divide
        // first j characters into i substrings

        vector<vector<int>> dp(k + 1,
                               vector<int>(n + 1, INF));

        dp[0][0] = 0;

        for (int i = 1; i <= k; i++) {
            for (int j = 2 * i; j <= n; j++) {

                for (int prev = 2 * (i - 1);
                     prev <= j - 2; prev++) {

                    dp[i][j] = min(
                        dp[i][j],
                        dp[i - 1][prev] + cost[prev][j - 1]
                    );
                }
            }
        }

        return dp[k][n];
    }
};
