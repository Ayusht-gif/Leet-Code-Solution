class Solution {
public:

    multiset<int> left, right;
    long long sumLeft = 0, sumRight = 0;

    void balance() {

        while (left.size() > right.size() + 1) {
            int val = *left.rbegin();

            left.erase(left.find(val));
            sumLeft -= val;

            right.insert(val);
            sumRight += val;
        }

        while (left.size() < right.size()) {
            int val = *right.begin();

            right.erase(right.find(val));
            sumRight -= val;

            left.insert(val);
            sumLeft += val;
        }
    }

    void add(int val) {

        if (left.empty() || val <= *left.rbegin()) {
            left.insert(val);
            sumLeft += val;
        }
        else {
            right.insert(val);
            sumRight += val;
        }

        balance();
    }

    void remove(int val) {

        auto it = left.find(val);

        if (it != left.end()) {
            left.erase(it);
            sumLeft -= val;
        }
        else {
            it = right.find(val);
            right.erase(it);
            sumRight -= val;
        }

        balance();
    }

    long long getCost() {

        long long median = *left.rbegin();

        long long costLeft =
            median * left.size() - sumLeft;

        long long costRight =
            sumRight - median * right.size();

        return costLeft + costRight;
    }

    long long minOperations(vector<int>& nums, int x, int k) {

        int n = nums.size();

        vector<long long> cost(n - x + 1);

        // Step 1: Sliding Window
        for (int i = 0; i < n; i++) {

            add(nums[i]);

            if (i >= x) {
                remove(nums[i - x]);
            }

            if (i >= x - 1) {
                cost[i - x + 1] = getCost();
            }
        }

        // Step 2: Dynamic Programming
        const long long INF = 1e18;

        vector<vector<long long>> dp(
            k + 1,
            vector<long long>(n + 1, INF)
        );

        dp[0][0] = 0;

        for (int j = 0; j <= k; j++) {

            for (int i = 1; i <= n; i++) {

                // Skip current element
                dp[j][i] = dp[j][i - 1];

                // Select a window of size x
                if (j > 0 && i >= x) {

                    dp[j][i] = min(
                        dp[j][i],
                        dp[j - 1][i - x] + cost[i - x]
                    );
                }
            }
        }

        return dp[k][n];
    }
};
