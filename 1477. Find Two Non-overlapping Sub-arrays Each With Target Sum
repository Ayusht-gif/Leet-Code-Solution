class Solution {
public:
    int minSumOfLengths(vector<int>& arr, int target) {
        int n = arr.size();
        const int INF = 1e9;

        vector<int> dp(n, INF);

        unordered_map<int, int> mp;
        mp[0] = -1;

        int prefix = 0;
        int best = INF;
        int ans = INF;

        for (int i = 0; i < n; i++) {
            prefix += arr[i];

            // If a subarray with sum = target ends at i
            if (mp.count(prefix - target)) {
                int start = mp[prefix - target];
                int len = i - start;

                // Previous non-overlapping subarray
                if (start >= 0 && dp[start] != INF) {
                    ans = min(ans, dp[start] + len);
                }

                // Store the minimum length ending at or before i
                best = min(best, len);
            }

            dp[i] = best;

            mp[prefix] = i;
        }

        return ans == INF ? -1 : ans;
    }
};
