class Solution {
public:
    bool checkValidString(string s) {
        int low = 0, high = 0;

        for (char c : s) {
            if (c == '(') {
                low++;
                high++;
            }
            else if (c == ')') {
                low--;
                high--;
            }
            else { // '*'
                low--;   // '*' can be ')'
                high++;  // '*' can be '('
            }

            // Even the maximum possible '(' count is negative
            if (high < 0)
                return false;

            // We cannot have fewer than 0 unmatched '('
            low = max(low, 0);
        }

        return low == 0;
    }
};
