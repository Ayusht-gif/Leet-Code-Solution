class Solution {
public:
    vector<int> findMissingElements(vector<int>& nums) {

        int n = nums.size();

        int mx = nums[0];
        int mn = nums[0];

        // find min and max
        for(int i = 1; i < n; i++){
            if(nums[i] > mx)
                mx = nums[i];
            if(nums[i] < mn)
                mn = nums[i];
        }

        vector<int> ans;

        // check missing numbers
        for(int i = mn; i <= mx; i++){
            bool found = false;
            for(int j = 0; j < n; j++){
                if(nums[j] == i){
                    found = true;
                    break;
                }
            }
            if(!found)
                ans.push_back(i);
        }

        return ans;
    }
};
